using JuegoRol.Entidades;
using JuegoRol.Interfaces;

namespace JuegoRol
{
    public class Program
    {
        public static void Main(string[] args)
        {
            Guerrero guerrero = new Guerrero(
                "Thorin",
                120,
                5,
                30,
                85);
                    

            Mago mago = new Mago(
                "Elara",
                90,
                7,
                60,
                25,
                90
            );

            Arquero arquero = new Arquero(
                "Robin",
                100,
                6,
                10,
                70,
                25
            );

            Sanador sanador = new Sanador(
                "Luna",
                85,
                4,
                30
            );

            Personaje[] personajes =
            {
    guerrero,
    mago,
    arquero,
    sanador
};

            Console.WriteLine("==========================================");
            Console.WriteLine("          SIMULADOR DE COMBATE");
            Console.WriteLine("==========================================");
            Console.WriteLine();

            Console.WriteLine("========== ESTADO INICIAL ==========");
            Console.WriteLine();

            foreach (Personaje personaje in personajes)
            {
                personaje.MostrarInformacion();
                Console.WriteLine();
            }

            Console.WriteLine("========== PRIMER COMBATE ==========");
            Console.WriteLine();

            guerrero.Atacar(mago);

            Console.WriteLine();

            mago.Atacar(guerrero);

            Console.WriteLine();

            arquero.Atacar(mago);

            Console.WriteLine();

            Console.WriteLine("========== CURACIÓN ==========");
            Console.WriteLine();

            guerrero.RecibirDanio(30);

            Console.WriteLine(
                $"Vida de {guerrero.Nombre}: " +
                $"{guerrero.Vida}/{guerrero.VidaMaxima}");

            Console.WriteLine();

            mago.Curar(guerrero);

            Console.WriteLine();

            Console.WriteLine("========== ENTRENAMIENTO ==========");
            Console.WriteLine();

            guerrero.Entrenar();

            Console.WriteLine();

            Console.WriteLine("========== COMBATE HASTA LA DERROTA ==========");
            Console.WriteLine();

            Console.WriteLine(
                $"{guerrero.Nombre} atacará a {mago.Nombre} " +
                $"hasta derrotarlo.");

            Console.WriteLine();

            while (mago.EstaVivo())
            {
                guerrero.Atacar(mago);

                Console.WriteLine();
            }

            Console.WriteLine(
                $"Estado de {mago.Nombre}: " +
                $"{mago.Vida}/{mago.VidaMaxima}");

            Console.WriteLine();

            Console.WriteLine("========== PERSONAJE DERROTADO ==========");
            Console.WriteLine();

            mago.Atacar(guerrero);

            Console.WriteLine();

            Console.WriteLine("========== REVIVIR ==========");
            Console.WriteLine();

            sanador.Revivir(mago);

            Console.WriteLine();

            Console.WriteLine("========== CURAR AL REVIVIDO ==========");
            Console.WriteLine();

            sanador.Curar(mago);

            Console.WriteLine();

            Console.WriteLine("========== POLIMORFISMO ==========");
            Console.WriteLine();

            foreach (Personaje personaje in personajes)
            {
                Console.WriteLine(
                    $"{personaje.Nombre} realiza su ataque:");

                personaje.Atacar(guerrero);

                Console.WriteLine();
            }

            Console.WriteLine("========== CAPACIDADES ==========");
            Console.WriteLine();

            foreach (Personaje personaje in personajes)
            {
                if (personaje is ICurador curador)
                {
                    Console.WriteLine(
                        $"{personaje.Nombre} puede curar.");
                }

                if (personaje is IRevividor revividor)
                {
                    Console.WriteLine(
                        $"{personaje.Nombre} puede revivir.");
                }
            }

            Console.WriteLine();

            Console.WriteLine("========== ESTADO FINAL ==========");
            Console.WriteLine();

            foreach (Personaje personaje in personajes)
            {
                string estado;

                if (personaje.EstaVivo())
                {
                    estado = "VIVO";
                }
                else
                {
                    estado = "DERROTADO";
                }

                Console.WriteLine(
                    $"{personaje.Nombre} → " +
                    $"Vida: {personaje.Vida}/{personaje.VidaMaxima} → " +
                    estado);
            }
        }
    }
}